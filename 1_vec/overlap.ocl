    int4 h_mask = (h > 0.0f);
    int4 f_mask = (f > 0.0f);

    int4 h_val = h_mask & 1;
    int4 f_val = f_mask & 2;

    int4 res = h_val | f_val;

    out[i] = convert_char4(res);
}

