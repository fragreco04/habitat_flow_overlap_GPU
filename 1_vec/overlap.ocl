kernel void overlap_vec1_k(
    global float const * restrict habitat,
    global float const * restrict flow,
    global char * restrict out,
    const int nels
) {
    const int i = get_global_id(0);

    if (i >= nels)
        return;

    int h_val = (habitat[i] > 0.0f) ? 1 : 0;
    int f_val = (flow[i] > 0.0f) ? 2 : 0;

    out[i] = h_val | f_val;
}

kernel void overlap_vec2_k(
    global float2 const * restrict habitat,
    global float2 const * restrict flow,
    global char2 * restrict out,
    const int nduos
) {
    const int i = get_global_id(0);

    if (i >= nduos)
        return;

    float2 h = habitat[i];
    float2 f = flow[i];

    // Otteniamo 0000000  oppure FFFFFF
    int2 h_mask = (h > 0.0f);
    int2 f_mask = (f > 0.0f);

    // Facciamo un AND
    int2 h_val = h_mask & 1;
    int2 f_val = f_mask & 2;

    // Facciamo un OR
    int2 res = h_val | f_val;

    out[i] = convert_char2(res);
}

kernel void overlap_vec4_k(
    global float4 const * restrict habitat,
